  { "path": "check_other.py", "class": "test", "context": { "configs": [{ "path": "pyproject.toml", "text": "[tool.pytest.ini_options]\npython_files = [\"check_*.py\"]\n" }] } },
  { "path": "src/a.check.js", "class": "source", "context": { "configs": [{ "path": "jest.config.js", "text": "{\"testMatch\":[\"**/*.check.js\"]}" }] } },
