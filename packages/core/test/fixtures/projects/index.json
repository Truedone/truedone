   "files": {
    "package.json": "{\"scripts\": {\"test\": \"react-scripts test\"}}"
   },
   "test": "src/App.test.jsx",
   "expect": {
    "runner": "jest",
    "cwd": ".",
    "reporter": "jest-json"
   }
  },
  {
   "name": "mocha from scripts.test",
   "files": {
    "package.json": "{\"scripts\": {\"test\": \"mocha 'test/**/*.spec.js'\"}}"
   },
   "test": "test/a.spec.js",
   "expect": {
    "runner": "mocha",
    "cwd": ".",
    "reporter": "mocha-json"
   }
  },
