   "test": "test/a.test.js",
   "expect": {
    "runner": null,
    "reason": "package.json"
   }
  },
  {
   "name": "no manifest at all",
   "files": {},
   "test": "test/a.test.js",
   "expect": {
    "runner": null,
    "reason": "no package.json"
   }
  },
  {
   "name": "a Python test with no Python manifest",
   "files": {
    "package.json": "{\"scripts\": {\"test\": \"jest\"}}"
   },
   "test": "tests/test_e.py",
   "expect": {
    "runner": null,
