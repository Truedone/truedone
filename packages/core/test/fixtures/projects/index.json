{
 "projects": [
  {
   "name": "vitest from scripts.test",
   "files": {
    "package.json": "{\"scripts\": {\"test\": \"vitest run\"}}"
   },
   "test": "src/a.test.ts",
   "expect": {
    "runner": "vitest",
    "cwd": ".",
    "reporter": "vitest-json"
   }
  },
  {
   "name": "jest from scripts.test",
   "files": {
    "package.json": "{\"scripts\": {\"test\": \"jest --coverage\"}}"
   },
   "test": "src/a.test.js",
   "expect": {
    "runner": "jest",
    "cwd": ".",
    "reporter": "jest-json"
   }
  },
  {
