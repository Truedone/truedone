   }
  },
  {
   "name": "ava is not a version 1 runner",
   "files": {
    "package.json": "{\"scripts\": {\"test\": \"ava\"}}"
   },
   "test": "test/a.js",
   "expect": {
    "runner": null,
    "reason": "ava"
   }
  },
  {
   "name": "npm's default test script names no runner",
   "files": {
    "package.json": "{\"scripts\": {\"test\": \"echo \\\"Error: no test specified\\\" && exit 1\"}}"
