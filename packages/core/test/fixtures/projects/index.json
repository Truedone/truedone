   "files": {
    "package.json": "{\"scripts\": {\"test\": \"nyc --reporter=text mocha\"}}"
   },
   "test": "test/a.js",
   "expect": {
    "runner": "mocha",
    "cwd": ".",
    "reporter": "mocha-json"
   }
  },
