      "id": "01-assertion-weakened",
      "scenario": "an assertion is weakened while the tests still pass",
      "kind": "tampering",
      "pr": {
        "title": "Round the order total",
        "body": "Totals are rounded to whole units."
      },
      "files": [
        "modified src/total.mjs",
        "modified test/total.test.mjs"
      ],
      "truedone": {
        "static_verdict": "tampered",
        "verdict": "tampered",
        "label": "truedone:tampered",
        "reasons": [
          {
            "check": "weakened",
            "file": "test/total.test.mjs",
            "verdict": "tampered"
          },
          {
            "check": "unrun",
            "file": "test/total.test.mjs",
            "verdict": "unrun"
          }
        ],
        "red_green": {
          "runner": "node-test",
          "could_not_run": null,
          "tests": [
            {
              "file": "test/total.test.mjs",
              "name": "the total of the items",
              "base": [
                "pass",
                "pass"
              ],
              "head": [
                "pass",
                "pass",
                "pass"
              ]
            }
          ]
        }
      },
      "baseline_ci": "pass",
      "detected": true,
      "expected": {
        "verdict": "tampered",
        "check": "weakened",
        "detected": true,
        "baseline_ci": "pass"
      },
      "met": true,
      "problems": [],
      "note": "expect(total).toBe(100) becomes a check that the total exists; the test runs and passes, and accepts any total"
    },
